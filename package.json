{
  "name": "undercut",
  "version": "0.1.0",
  "private": true,
  "description": "UDP telemetry bridge for F1 26 - streams a race-engineer dashboard to any browser on your LAN - tablet, phone, laptop or second monitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikarnadella/f1-race-engineer.git"
  },
  "homepage": "https://github.com/srikarnadella/f1-race-engineer#readme",
  "bugs": "https://github.com/srikarnadella/f1-race-engineer/issues",
  "main": "desktop/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "app": "install-electron && electron .",
    "app:build": "electron-builder --win",
    "record": "node src/index.js --record",
    "capture": "node src/index.js --capture",
    "analyze": "node scripts/analyze-capture.js",
    "train:overtake": "node scripts/train-overtake.js",
    "demo": "node scripts/generate-demo-session.js --if-missing && node src/index.js --demo demo/synthetic-session.f1log",
    "demo:regenerate": "node scripts/generate-demo-session.js",
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc -p . && tsc -p tsconfig.public.json",
    "accuracy": "node scripts/accuracy.js",
    "site": "node scripts/build-demo-site.js",
    "test:coverage": "c8 --all --include \"src/**\" --include \"public/**\" --check-coverage --lines 88 --branches 84 --functions 86 --reporter text-summary node --test",
    "dataset": "node scripts/build-dataset.js",
    "db": "node scripts/build-db.js",
    "backtest": "node scripts/backtest.js"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.20.5",
    "c8": "^10.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "io.github.srikarnadella.undercut",
    "productName": "Undercut",
    "files": [
      "desktop/**",
      "src/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "artifactName": "Undercut-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "productName": "Undercut"
}
