demo/synthetic-session.f1log
*.log
# Local editor / assistant settings.
.claude/
.vscode/
.DS_Store
Thumbs.db
# Demo website: rebuilt by CI (npm run site); only site/race-data/ is committed.
site/demo-data/
_site/
# Private review notes - not part of the repo.
notes/
# Coverage output (npm run test:coverage).
coverage/
# Python environment for ml/ (pip install -r ml/requirements.txt).
.venv/
__pycache__/
